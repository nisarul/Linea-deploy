{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "13283659479357079004"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "linea",
      "minLength": 3,
      "maxLength": 11,
      "metadata": {
        "description": "Prefix used in resource names (lower-case, no dashes for storage)."
      }
    },
    "lineaServerImage": {
      "type": "string",
      "metadata": {
        "description": "Container image for Linea-server (e.g. ghcr.io/nisarul/linea-server:v0.2.0)."
      }
    },
    "lineaWebImage": {
      "type": "string",
      "metadata": {
        "description": "Container image for Linea-web (e.g. ghcr.io/nisarul/linea-web:v1.0.0)."
      }
    },
    "oidcIssuer": {
      "type": "string",
      "metadata": {
        "description": "Entra ID OIDC issuer URL, e.g. https://login.microsoftonline.com/<tenantId>/v2.0"
      }
    },
    "lineaWebClientId": {
      "type": "string",
      "metadata": {
        "description": "Entra ID app registration client id for Linea-web (BFF, confidential client)."
      }
    },
    "lineaServerAudience": {
      "type": "string",
      "metadata": {
        "description": "Entra ID expected audience for Linea-server (typically the Linea-web client id)."
      }
    },
    "lineaWebClientSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Linea-web client secret. Stored as a secret in the Container App."
      }
    },
    "registryServer": {
      "type": "string",
      "defaultValue": "ghcr.io",
      "metadata": {
        "description": "Image registry server (e.g. ghcr.io). Empty for public images."
      }
    },
    "registryUsername": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Registry username. Empty for anonymous pulls of public images."
      }
    },
    "registryPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Registry password / token. Empty for anonymous pulls of public images."
      }
    }
  },
  "variables": {
    "storageAccountName": "[toLower(replace(format('{0}st{1}', parameters('namePrefix'), uniqueString(resourceGroup().id)), '-', ''))]",
    "logWorkspaceName": "[format('{0}-logs', parameters('namePrefix'))]",
    "envName": "[format('{0}-env', parameters('namePrefix'))]",
    "serverAppName": "[format('{0}-server', parameters('namePrefix'))]",
    "webAppName": "[format('{0}-web', parameters('namePrefix'))]",
    "serverShareName": "server-data",
    "webShareName": "web-data",
    "serverStorageName": "serverdata",
    "webStorageName": "webdata"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logWorkspaceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2024-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "allowSharedKeyAccess": true,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}/{1}', variables('storageAccountName'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', variables('serverShareName'))]",
      "properties": {
        "shareQuota": 16,
        "enabledProtocols": "SMB"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices', variables('storageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', variables('webShareName'))]",
      "properties": {
        "shareQuota": 4,
        "enabledProtocols": "SMB"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices', variables('storageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('envName')]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('logWorkspaceName')), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('logWorkspaceName')), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logWorkspaceName'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments/storages",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', variables('envName'), variables('serverStorageName'))]",
      "properties": {
        "azureFile": {
          "accountName": "[variables('storageAccountName')]",
          "accountKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2024-01-01').keys[0].value]",
          "shareName": "[variables('serverShareName')]",
          "accessMode": "ReadWrite"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments/storages",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', variables('envName'), variables('webStorageName'))]",
      "properties": {
        "azureFile": {
          "accountName": "[variables('storageAccountName')]",
          "accountKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2024-01-01').keys[0].value]",
          "shareName": "[variables('webShareName')]",
          "accessMode": "ReadWrite"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('serverAppName')]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": false,
            "targetPort": 8080,
            "transport": "http",
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ]
          },
          "registries": "[if(empty(parameters('registryUsername')), createArray(), createArray(createObject('server', parameters('registryServer'), 'username', parameters('registryUsername'), 'passwordSecretRef', 'registry-password')))]",
          "secrets": "[if(empty(parameters('registryPassword')), createArray(), createArray(createObject('name', 'registry-password', 'value', parameters('registryPassword'))))]"
        },
        "template": {
          "revisionSuffix": "v1",
          "containers": [
            {
              "name": "linea-server",
              "image": "[parameters('lineaServerImage')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "LINEA_ADDR",
                  "value": ":8080"
                },
                {
                  "name": "LINEA_DATA_DIR",
                  "value": "/data"
                },
                {
                  "name": "LINEA_OIDC_ISSUER",
                  "value": "[parameters('oidcIssuer')]"
                },
                {
                  "name": "LINEA_OIDC_AUDIENCE",
                  "value": "[parameters('lineaServerAudience')]"
                }
              ],
              "volumeMounts": [
                {
                  "volumeName": "data",
                  "mountPath": "/data"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "periodSeconds": 30
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/readyz",
                    "port": 8080
                  },
                  "periodSeconds": 10
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "data",
              "storageType": "AzureFile",
              "storageName": "[variables('serverStorageName')]"
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "[resourceId('Microsoft.App/managedEnvironments/storages', variables('envName'), variables('serverStorageName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('webAppName')]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8090,
            "transport": "http",
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ]
          },
          "registries": "[if(empty(parameters('registryUsername')), createArray(), createArray(createObject('server', parameters('registryServer'), 'username', parameters('registryUsername'), 'passwordSecretRef', 'registry-password')))]",
          "secrets": "[concat(createArray(createObject('name', 'oidc-client-secret', 'value', parameters('lineaWebClientSecret'))), if(empty(parameters('registryPassword')), createArray(), createArray(createObject('name', 'registry-password', 'value', parameters('registryPassword')))))]"
        },
        "template": {
          "revisionSuffix": "v1",
          "containers": [
            {
              "name": "linea-web",
              "image": "[parameters('lineaWebImage')]",
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              },
              "env": [
                {
                  "name": "LINEA_BFF_ADDR",
                  "value": ":8090"
                },
                {
                  "name": "LINEA_BFF_COOKIE_SECURE",
                  "value": "true"
                },
                {
                  "name": "LINEA_BFF_SESSION_DIR",
                  "value": "/data/sessions"
                },
                {
                  "name": "LINEA_BFF_UPSTREAM_URL",
                  "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('serverAppName')), '2024-03-01').configuration.ingress.fqdn)]"
                },
                {
                  "name": "LINEA_OIDC_ISSUER",
                  "value": "[parameters('oidcIssuer')]"
                },
                {
                  "name": "LINEA_OIDC_CLIENT_ID",
                  "value": "[parameters('lineaWebClientId')]"
                },
                {
                  "name": "LINEA_OIDC_CLIENT_SECRET",
                  "secretRef": "oidc-client-secret"
                },
                {
                  "name": "LINEA_OIDC_REDIRECT_URL",
                  "value": "[format('https://{0}.{1}/auth/callback', variables('webAppName'), reference(resourceId('Microsoft.App/managedEnvironments', variables('envName')), '2024-03-01').defaultDomain)]"
                },
                {
                  "name": "LINEA_BFF_POST_LOGIN_URL",
                  "value": "/"
                }
              ],
              "volumeMounts": [
                {
                  "volumeName": "data",
                  "mountPath": "/data"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8090
                  },
                  "periodSeconds": 30
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/readyz",
                    "port": 8090
                  },
                  "periodSeconds": 10
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "data",
              "storageType": "AzureFile",
              "storageName": "[variables('webStorageName')]"
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "[resourceId('Microsoft.App/containerApps', variables('serverAppName'))]",
        "[resourceId('Microsoft.App/managedEnvironments/storages', variables('envName'), variables('webStorageName'))]"
      ]
    }
  ],
  "outputs": {
    "webUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('webAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "serverInternalUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('serverAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "webAppName": {
      "type": "string",
      "value": "[variables('webAppName')]"
    },
    "serverAppName": {
      "type": "string",
      "value": "[variables('serverAppName')]"
    },
    "redirectUri": {
      "type": "string",
      "value": "[format('https://{0}/auth/callback', reference(resourceId('Microsoft.App/containerApps', variables('webAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "logWorkspaceName": {
      "type": "string",
      "value": "[variables('logWorkspaceName')]"
    }
  }
}